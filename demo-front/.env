# 비워두면 '/api' (개발 시 Vite 프록시 사용). 배포 환경에서는 실제 API 주소로.
VITE_API_BASE_URL=/api


# ── 소셜 로그인 (값이 있는 제공자만 버튼이 나타난다) ─────────────────────────
# client-id 만 둔다. client-secret 은 프론트에 두지 말고 "백엔드" 환경변수에만 둔다.
# 각 제공자 콘솔의 Redirect URI 에는 아래를 등록 (개발 환경 기준):
#   http://localhost:3000/auth/callback/kakao
#   http://localhost:3000/auth/callback/naver
#   http://localhost:3000/auth/callback/google
VITE_KAKAO_CLIENT_ID=1d7177e86e9bec9878ff52fd0544b4c6     # 카카오 개발자 > 앱 > REST API 키
VITE_NAVER_CLIENT_ID=5nO_8phmNtOtLxML7XFG      # 네이버 개발자센터 > Client ID
VITE_GOOGLE_CLIENT_ID=448250412146-nk6frrlcncnga0aoc13a7qnkr3g6gap6.apps.googleusercontent.com     # Google Cloud Console > OAuth 클라이언트 ID(웹 애플리케이션)
